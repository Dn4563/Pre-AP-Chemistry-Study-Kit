      "title": "How the model of the atom changed",
      "deck": 2,
      "steps": [
        "Dalton: solid indivisible atoms (1810)",
        "Thomson: electrons, plum pudding (1897)",
        "Rutherford: dense positive nucleus (1911)",
        "Bohr: electrons in fixed orbits (1913)",
        "Chadwick: the neutron (1932)",
        "Modern: electrons in orbitals"
      ]
    },
    {
      "id": "F2",
      "title": "From atoms to an ionic compound",
      "deck": 5,
      "steps": [
        "Metal atom loses electrons",
        "Cation forms",
        "Nonmetal atom gains electrons",
        "Anion forms",
        "Opposite charges attract (ionic bond)",
        "Neutral formula, charges sum to zero"
      ]
    },
    {
      "id": "F3",
      "title": "Counting particles from a symbol",
      "deck": 3,
      "steps": [
        "Protons = atomic number (Z)",
        "Neutrons = mass number (A) - Z",
        "Electrons = Z - charge"
      ]
    },
    {
      "id": "F4",
      "title": "Weighted average atomic mass",
      "deck": 4,
      "steps": [
        "Turn each percent into a decimal",
        "Multiply each decimal by that isotope's mass",
        "Add the products",
        "Check: the answer lands near the most common isotope"
      ]
    },
    {
      "id": "F5",
      "title": "Grams to atoms",
      "deck": 6,
      "steps": [
        "Grams of compound",
        "÷ molar mass = moles of compound",
        "× subscript = moles of one element",
        "× 6.022 × 10²³ = number of atoms"
      ]
    }
