{
 "flows": [
  {
   "id": "F1",
   "title": "Which type is it? (your dichotomous key)",
   "deck": 7,
   "steps": [
    "Starts with H? → Type V acid (no oxygen: hydro-…-ic; -ate → -ic; -ite → -ous)",
    "Not an acid: more than two elements? → Type IV, polyatomic ion (name it as on your sheet)",
    "Two elements, metal + nonmetal? → ionic: Type I (one-charge metal) or Type II (Roman numeral)",
    "Two nonmetals? → Type III covalent: prefixes, no mono- on the first element"
   ]
  },
  {
   "id": "F2",
   "title": "Writing an ionic formula",
   "deck": 2,
   "steps": [
    "Write the cation's charge (group number, or the Roman numeral)",
    "Write the anion's charge (group, or your ion sheet)",
    "If the charges cancel, write cation then anion",
    "If not, crisscross the charge numbers into subscripts",
    "Polyatomic ion needed more than once? Put it in parentheses",
    "Reduce to the lowest ratio"
   ]
  },
  {
   "id": "F3",
   "title": "Naming a variable-charge metal compound (Type II)",
   "deck": 3,
   "steps": [
    "Find the anion's charge",
    "Multiply by its subscript: total negative charge",
    "Divide by the number of metal atoms: the metal's charge",
    "Write the metal, its charge as a Roman numeral, then the anion"
   ]
  }
 ],
